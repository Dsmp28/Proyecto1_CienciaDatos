%% Modelo dimensional Gold · Agencia Metropolitana de Transporte
%% Grano de fct_abordaje: una validación de una tarjeta de un usuario en un modo, en una estación o parada, en un instante.
erDiagram
    dim_tiempo {
        int tiempo_sk PK "fecha*100 + hora (p. ej. 2026060107)"
        date fecha
        int hora "0-23"
        string franja "madrugada|pico_manana|valle|pico_tarde|noche"
        bool es_hora_pico
        bool es_dia_habil "lun-vie no feriado"
        string dia_semana
        bool es_feriado
    }
    dim_modo {
        string modo_id PK "TM|TU|MR|AM"
        string nombre "Transmetro|Transurbano|MetroRiel|Aerometro"
        string tipo "BRT|bus|tren ligero|teleferico"
        string via_ingesta "streaming|batch"
    }
    dim_zona {
        string zona_id PK "GT-Z01 … GT-MIXCO"
        string zona_nombre
        string tipo "zona_ciudad|municipio"
        string municipio
        bool presente_en_datos
    }
    dim_estacion {
        string estacion_sk PK "HMAC no: hash determinista de modo+codigo"
        string modo_id FK
        string codigo_nativo "TM-L1-01 | R-101-1 | 12 | AM11"
        string nombre
        string linea_ruta_eje
        string zona_id FK
        float lat
        float lon
        string archivo_origen "linaje"
    }
    dim_usuario {
        string usuario_sk PK "HMAC-SHA256(sal, modo|llave)"
        string modo_id FK "modo emisor de la tarjeta"
        string usuario_unificado_sk "HMAC(sal, BASE|id); NULL si no vinculable"
        string perfil "solo si esta en el padron"
        string zona_residencia_id FK "solo si esta en el padron"
        string estado_padron "ACTIVA|INACTIVA|SIN_PADRON"
        datetime vigente_desde "SCD2"
        datetime vigente_hasta "SCD2, NULL = vigente"
        bool es_vigente
    }
    dim_fuente {
        string fuente_sk PK
        string fuente
        string archivo
        string via "batch|streaming|cdc"
        date ingest_date
        string sha256
    }
    fct_abordaje {
        string abordaje_sk PK
        int tiempo_sk FK
        string modo_id FK
        string estacion_sk FK
        string zona_id FK
        string usuario_sk FK
        string fuente_sk FK
        datetime fecha_hora "hora local"
        numeric monto_q "aditiva"
        int abordajes "=1, aditiva"
        string tipo_validacion "ENTRADA|TRANSBORDO|OK|…"
        string objeto_gcs "linaje"
    }
    fct_viaje_metroriel {
        int trip_id PK
        int tiempo_sk_entrada FK
        int tiempo_sk_salida FK
        string estacion_sk_origen FK
        string estacion_sk_destino FK
        string zona_id_origen FK
        string zona_id_destino FK
        string usuario_sk FK
        string fuente_sk FK
        numeric monto_q "aditiva"
        int duracion_s "aditiva"
        int viajes "=1"
    }
    fct_uso_usuario_dia {
        string usuario_sk FK
        string usuario_unificado_sk
        date fecha
        string modo_id FK
        int abordajes "aditiva"
        numeric monto_q "aditiva"
        int abordajes_hora_pico "aditiva"
        string zona_id_mas_frecuente FK
    }
    fct_cobertura_zona_modo {
        string zona_id FK
        string modo_id FK
        int estaciones "conteo de estaciones/paradas"
        string fuente_sk FK
    }
    fct_cambio_padron {
        int seq PK
        int tiempo_sk FK
        string usuario_sk FK
        string operacion "INSERT|UPDATE|DELETE"
        bool alta_implicita
        bool baja_sin_alta_previa
        int tarjetas_activas_despues "semi aditiva (saldo)"
        string fuente_sk FK
    }

    dim_tiempo ||--o{ fct_abordaje : "tiempo_sk"
    dim_modo ||--o{ fct_abordaje : "modo_id"
    dim_estacion ||--o{ fct_abordaje : "estacion_sk"
    dim_zona ||--o{ fct_abordaje : "zona_id"
    dim_usuario ||--o{ fct_abordaje : "usuario_sk"
    dim_fuente ||--o{ fct_abordaje : "fuente_sk"

    dim_tiempo ||--o{ fct_viaje_metroriel : "entrada / salida"
    dim_estacion ||--o{ fct_viaje_metroriel : "origen / destino"
    dim_zona ||--o{ fct_viaje_metroriel : "origen / destino"
    dim_usuario ||--o{ fct_viaje_metroriel : "usuario_sk"
    dim_fuente ||--o{ fct_viaje_metroriel : "fuente_sk"

    dim_usuario ||--o{ fct_uso_usuario_dia : "usuario_sk"
    dim_modo ||--o{ fct_uso_usuario_dia : "modo_id"
    dim_zona ||--o{ fct_uso_usuario_dia : "zona mas frecuente"

    dim_zona ||--o{ fct_cobertura_zona_modo : "zona_id"
    dim_modo ||--o{ fct_cobertura_zona_modo : "modo_id"

    dim_tiempo ||--o{ fct_cambio_padron : "tiempo_sk"
    dim_usuario ||--o{ fct_cambio_padron : "usuario_sk"

    dim_modo ||--o{ dim_estacion : "modo_id"
    dim_zona ||--o{ dim_estacion : "zona_id"
    dim_modo ||--o{ dim_usuario : "modo_id"
