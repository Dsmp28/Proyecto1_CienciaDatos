# Plantilla de vm/.env. NO editar a mano en la VM: startup.sh la rellena en cada
# arranque a partir de la metadata de la instancia y de Secret Manager, y escribe
# vm/.env (ignorado por git). Los marcadores con doble guion bajo (CLAVE entre
# dos pares de '__') se sustituyen con un pequeño script de Python, que escribe cada
# valor entre comillas simples para que Compose no interprete $, # ni comillas.
#
# La sal HMAC (secreto hmac-salt) NO se escribe aquí: el DAG la lee de
# Secret Manager en tiempo de ejecución con la cuenta de servicio de la VM.

# --- Identidad de los contenedores de Airflow (usuario airflow de la imagen) ---
AIRFLOW_UID=50000
TZ=America/Guatemala

# --- GCP (metadata de instancia: project-id, region, lake-bucket) ---
GCP_PROJECT_ID=__GCP_PROJECT_ID__
GCP_REGION=__GCP_REGION__
LAKE_BUCKET=__LAKE_BUCKET__

# --- Airflow ---
# Dominio público (metadata airflow-host, p. ej. airflow.34.1.2.3.sslip.io)
AIRFLOW_HOST=__AIRFLOW_HOST__
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__AIRFLOW_ADMIN_PASSWORD__
AIRFLOW_VIEWER_USER=catedratico
AIRFLOW_VIEWER_PASSWORD=__AIRFLOW_VIEWER_PASSWORD__
AIRFLOW_FERNET_KEY=__AIRFLOW_FERNET_KEY__
# Secretos internos de Airflow 3 (JWT entre componentes y clave del api-server).
# Los genera startup.sh una sola vez y los persiste en /etc/red-metropolitana/.
AIRFLOW_JWT_SECRET=__AIRFLOW_JWT_SECRET__
AIRFLOW_API_SECRET_KEY=__AIRFLOW_API_SECRET_KEY__

# --- Caddy (correo de la cuenta ACME; Let's Encrypt no lo verifica) ---
ACME_EMAIL=__ACME_EMAIL__

# --- Kafka (solo red interna de Docker; sin puertos publicados) ---
KAFKA_BOOTSTRAP=kafka:9092
