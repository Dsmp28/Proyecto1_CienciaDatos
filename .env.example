# Copia a .env y completa. NUNCA subas .env al repo.
# Los valores reales viven en Secret Manager (ver docs/governance/seguridad.md).

# --- GCP ---
GCP_PROJECT_ID=cienciadatos-509301
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
LAKE_BUCKET=cienciadatos-509301-lake

# --- Pipeline ---
ESCALA=                       # vacío = valor por defecto del generador (0.08 ≈ 137 MB)
FECHA_REFERENCIA=             # YYYY-MM-DD, fija; nunca CURRENT_DATE

# --- Airflow (solo en la VM; la contraseña real sale de Secret Manager) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=       # secreto: airflow-admin-password
AIRFLOW_VIEWER_USER=catedratico
AIRFLOW_VIEWER_PASSWORD=      # secreto: airflow-viewer-password
AIRFLOW_FERNET_KEY=           # secreto: airflow-fernet-key
AIRFLOW_HOST=                 # p. ej. airflow.34.1.2.3.sslip.io

# --- Seudonimización ---
HMAC_SALT=                    # secreto: hmac-salt (32+ bytes aleatorios). Nunca en el repo.

# --- Kafka (interno a la VM, no expuesto) ---
KAFKA_BOOTSTRAP=kafka:9092
